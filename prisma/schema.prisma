// Prisma schema for the online exam / anti-cheat system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  TERMINATED
}

enum CheatEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_ATTEMPT
  PASTE_ATTEMPT
  CONTEXT_MENU
  DEVTOOLS_SUSPECTED
  MULTIPLE_SESSION_BLOCKED
  SHORTCUT_BLOCKED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model Teacher {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exams         Exam[]
  classSections ClassSection[]
}

// A roster (شعبة/فصل) the teacher manages. Grades, projects and attendance
// are all scoped to one of these, and each student belongs to exactly one.
model ClassSection {
  id        String  @id @default(cuid())
  name      String
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Weights used to compute each student's overall ranking score. Stored as
  // whatever the teacher enters (not required to sum to 100) — the ranking
  // calculation normalizes them and redistributes weight away from any
  // category a student has no data in yet, so a partially-graded class
  // still produces a fair comparison.
  examWeight        Int @default(50)
  manualGradeWeight Int @default(20)
  projectWeight     Int @default(20)
  attendanceWeight  Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students           StudentProfile[]
  projects           Project[]
  attendanceSessions AttendanceSession[]
}

// A persistent student in a class roster, independent of any single exam
// attempt. Exam codes generated "from a class" are pre-linked to one of
// these so exam results roll up automatically into the student's record.
model StudentProfile {
  id             String       @id @default(cuid())
  fullName       String
  studentRef     String? // student ID / seat number, unique within the class
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examCodes         ExamCode[]
  manualGrades      ManualGrade[]
  projectGrades     ProjectGrade[]
  attendanceRecords AttendanceRecord[]

  @@index([classSectionId])
}

// A manually-entered grade (quiz, homework, participation, ...) that isn't
// tied to the exam system or to a specific Project.
model ManualGrade {
  id       String   @id @default(cuid())
  title    String
  score    Float
  maxScore Float
  notes    String?
  gradedAt DateTime @default(now())

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model Project {
  id          String    @id @default(cuid())
  title       String
  description String?
  maxScore    Float     @default(100)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  grades ProjectGrade[]
}

model ProjectGrade {
  id        String    @id @default(cuid())
  score     Float?
  feedback  String?
  gradedAt  DateTime?
  updatedAt DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([projectId, studentProfileId])
}

// One lecture/session date for a class. Attendance is recorded either by
// the teacher directly or by students self-checking-in with a short-lived
// code while the session is open.
model AttendanceSession {
  id    String   @id @default(cuid())
  title String?
  date  DateTime @default(now())

  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  selfCheckinCode     String?   @unique
  selfCheckinOpensAt  DateTime?
  selfCheckinClosesAt DateTime?

  createdAt DateTime @default(now())

  records AttendanceRecord[]

  @@index([classSectionId])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  status       AttendanceStatus @default(PRESENT)
  markedBySelf Boolean          @default(false)
  markedAt     DateTime         @default(now())

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentProfileId])
}

model Exam {
  id               String   @id @default(cuid())
  title            String
  description      String?
  durationMinutes  Int
  shuffleQuestions Boolean  @default(true)
  shuffleChoices   Boolean  @default(true)
  maxTabViolations Int      @default(3)
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  questions Question[]
  codes     ExamCode[]
  attempts  ExamAttempt[]
}

model Question {
  id            String       @id @default(cuid())
  type          QuestionType @default(MULTIPLE_CHOICE)
  text          String
  points        Int          @default(1)
  order         Int          @default(0)
  correctAnswer String? // used for SHORT_ANSWER exact-match / TRUE_FALSE ("true"/"false")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  choices Choice[]
  answers Answer[]
}

model Choice {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answers Answer[] @relation("SelectedChoice")
}

// A code the teacher generates and shares with a specific student (or a batch).
// Joining an exam always requires a valid, unused-or-in-progress code.
model ExamCode {
  id          String    @id @default(cuid())
  code        String    @unique
  studentName String?
  studentRef  String? // e.g. student ID / seat number, set by teacher
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  // Set when the code was generated from a class roster, so the resulting
  // exam score rolls up automatically into that student's record.
  studentProfileId String?
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)

  attempt ExamAttempt?

  @@index([studentProfileId])
}

model ExamAttempt {
  id             String        @id @default(cuid())
  status         AttemptStatus @default(IN_PROGRESS)
  studentName    String
  studentRef     String?
  startedAt      DateTime      @default(now())
  deadlineAt     DateTime // server-computed: startedAt + exam.durationMinutes, authoritative for timing
  submittedAt    DateTime?
  score          Float?
  maxScore       Float?
  tabViolations  Int           @default(0)
  sessionToken   String        @unique // bound to the browser session that started the attempt
  ipAddress      String?
  questionOrder  String // JSON array of question IDs in the (shuffled) order shown to this student
  choiceOrderMap String // JSON map of questionId -> shuffled choice ID order

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  examCodeId String   @unique
  examCode   ExamCode @relation(fields: [examCodeId], references: [id], onDelete: Cascade)

  answers   Answer[]
  cheatLogs CheatLog[]

  @@index([examId])
}

model Answer {
  id            String   @id @default(cuid())
  textAnswer    String?
  isCorrect     Boolean?
  pointsAwarded Float?
  updatedAt     DateTime @updatedAt

  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedChoiceId String?
  selectedChoice   Choice? @relation("SelectedChoice", fields: [selectedChoiceId], references: [id])

  @@unique([attemptId, questionId])
}

model CheatLog {
  id        String         @id @default(cuid())
  type      CheatEventType
  detail    String?
  createdAt DateTime       @default(now())

  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}
