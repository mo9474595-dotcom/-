// Prisma schema for the online exam / anti-cheat system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  TERMINATED
}

enum CheatEventType {
  TAB_HIDDEN
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_ATTEMPT
  PASTE_ATTEMPT
  CONTEXT_MENU
  DEVTOOLS_SUSPECTED
  MULTIPLE_SESSION_BLOCKED
  SHORTCUT_BLOCKED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model Teacher {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  // Bumped by "logout from all devices" — embedded in every issued JWT and
  // checked on each request, so a stale/stolen token stops working
  // immediately instead of waiting out its 12h expiry.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Set only on a teaching-assistant account: logs in through the exact
  // same login form as any other teacher, but everything it can see/do is
  // scoped to the owning teacher's data (see resolveScopeTeacherId in
  // lib/auth.ts) rather than its own — an assistant never owns classes or
  // exams itself. An assistant cannot itself own further assistants.
  ownerId    String?
  owner      Teacher?  @relation("TeacherAssistants", fields: [ownerId], references: [id], onDelete: Cascade)
  assistants Teacher[] @relation("TeacherAssistants")

  exams            Exam[]
  classSections    ClassSection[]
  auditLogs        AuditLog[]
  bankQuestions    BankQuestion[]
  notifications    Notification[]
  feedbackSnippets FeedbackSnippet[]
  backups          Backup[]
}

// A scheduled automatic snapshot of everything a teacher owns (same shape
// as the manual export), generated periodically by /api/cron/backups.
// Only the most recent few are kept per teacher (see the cron route) so
// this table doesn't grow unbounded.
model Backup {
  id        String   @id @default(cuid())
  data      String // JSON payload, same shape as the manual export endpoint
  createdAt DateTime @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
}

// A teacher's personal library of reusable feedback phrases, inserted with
// one click while grading short-answer questions instead of retyping the
// same comment over and over.
model FeedbackSnippet {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

// An in-app notification about something a teacher would want to know
// about soon (a student submitted, an attempt was cut short by anti-cheat
// enforcement). Polled by the notification bell in the teacher app shell.
model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, read, createdAt])
}

// A record of a sensitive manual action a teacher took, for accountability
// (e.g. overriding a grade, resetting a stuck exam attempt). Kept even if
// the entity it refers to is later deleted.
model AuditLog {
  id        String   @id @default(cuid())
  action    String // short machine key, e.g. "MANUAL_GRADE_SET"
  summary   String // human-readable Arabic one-liner, ready to display
  createdAt DateTime @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classSectionId String?
  examId         String?

  @@index([teacherId, createdAt])
  @@index([classSectionId])
  @@index([examId])
}

// A roster (شعبة/فصل) the teacher manages. Grades, projects and attendance
// are all scoped to one of these, and each student belongs to exactly one.
model ClassSection {
  id        String  @id @default(cuid())
  name      String
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // Weights used to compute each student's overall ranking score. Stored as
  // whatever the teacher enters (not required to sum to 100) — the ranking
  // calculation normalizes them and redistributes weight away from any
  // category a student has no data in yet, so a partially-graded class
  // still produces a fair comparison.
  examWeight        Int @default(50)
  manualGradeWeight Int @default(20)
  projectWeight     Int @default(20)
  attendanceWeight  Int @default(10)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft-delete: hidden from normal listings when set, recoverable from the
  // trash view until permanently purged.
  deletedAt DateTime?

  students           StudentProfile[]
  projects           Project[]
  attendanceSessions AttendanceSession[]
}

// A persistent student in a class roster, independent of any single exam
// attempt. Exam codes generated "from a class" are pre-linked to one of
// these so exam results roll up automatically into the student's record.
model StudentProfile {
  id             String       @id @default(cuid())
  fullName       String
  studentRef     String? // student ID / seat number, unique within the class
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  // Bearer token for the student's personal portal link — no password, no
  // account. Regeneratable by the teacher if a link leaks.
  portalToken        String    @unique @default(cuid())
  portalAccessCount  Int       @default(0)
  portalLastAccessAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examCodes         ExamCode[]
  manualGrades      ManualGrade[]
  projectGrades     ProjectGrade[]
  attendanceRecords AttendanceRecord[]

  @@index([classSectionId])
}

// A manually-entered grade (quiz, homework, participation, ...) that isn't
// tied to the exam system or to a specific Project.
model ManualGrade {
  id       String   @id @default(cuid())
  title    String
  score    Float
  maxScore Float
  notes    String?
  gradedAt DateTime @default(now())

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
}

model Project {
  id          String    @id @default(cuid())
  title       String
  description String?
  maxScore    Float     @default(100)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  grades ProjectGrade[]
}

model ProjectGrade {
  id        String    @id @default(cuid())
  score     Float?
  feedback  String?
  gradedAt  DateTime?
  updatedAt DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([projectId, studentProfileId])
}

// One lecture/session date for a class. Attendance is recorded either by
// the teacher directly or by students self-checking-in with a short-lived
// code while the session is open.
model AttendanceSession {
  id    String   @id @default(cuid())
  title String?
  date  DateTime @default(now())

  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  selfCheckinCode     String?   @unique
  selfCheckinOpensAt  DateTime?
  selfCheckinClosesAt DateTime?

  createdAt DateTime @default(now())

  records AttendanceRecord[]

  @@index([classSectionId])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  status       AttendanceStatus @default(PRESENT)
  markedBySelf Boolean          @default(false)
  markedAt     DateTime         @default(now())

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentProfileId])
}

model Exam {
  id               String    @id @default(cuid())
  title            String
  description      String?
  durationMinutes  Int
  shuffleQuestions Boolean   @default(true)
  shuffleChoices   Boolean   @default(true)
  maxTabViolations Int       @default(3)
  isPublished      Boolean   @default(false)
  // Separate from isPublished (which controls whether students can take the
  // exam at all): this gates the detailed per-question review students see
  // after they've finished, so a teacher can grade manual (SHORT_ANSWER)
  // answers before revealing correct answers to the whole class.
  resultsPublished Boolean   @default(false)
  // Optional future time at which resultsPublished flips on by itself (see
  // isResultsPublished in exam-review.ts) — checked lazily on the next
  // read rather than needing a background job.
  resultsPublishAt DateTime?
  // Optional availability window on top of isPublished. Null means "no
  // restriction on that side" — e.g. opensAt set with closesAt null stays
  // open indefinitely once it opens.
  opensAt          DateTime?
  closesAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // Soft-delete: hidden from normal listings when set, recoverable from the
  // trash view until permanently purged.
  deletedAt        DateTime?

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  questions Question[]
  codes     ExamCode[]
  attempts  ExamAttempt[]
}

model Question {
  id            String       @id @default(cuid())
  type          QuestionType @default(MULTIPLE_CHOICE)
  text          String
  points        Int          @default(1)
  order         Int          @default(0)
  correctAnswer String? // used for SHORT_ANSWER exact-match / TRUE_FALSE ("true"/"false")
  // A data: URL (base64), compressed client-side before upload — there's no
  // blob storage in this stack, so the image is stored inline. Prisma maps
  // String to Postgres "text" by default, which has no practical size cap.
  imageUrl      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  choices Choice[]
  answers Answer[]
}

model Choice {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answers Answer[] @relation("SelectedChoice")
}

// A teacher's personal, reusable library of questions — independent of any
// one exam. Questions are copied into an Exam's Question/Choice rows when
// inserted, so later edits here or deleting a bank entry never affect an
// exam that already used it.
model BankQuestion {
  id            String       @id @default(cuid())
  type          QuestionType @default(MULTIPLE_CHOICE)
  text          String
  points        Int          @default(1)
  correctAnswer String?
  imageUrl      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  choices BankChoice[]

  @@index([teacherId])
}

model BankChoice {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  bankQuestionId String
  bankQuestion   BankQuestion @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)
}

// A code the teacher generates and shares with a specific student (or a batch).
// Joining an exam always requires a valid, unused-or-in-progress code.
model ExamCode {
  id           String    @id @default(cuid())
  code         String    @unique
  studentName  String?
  studentRef   String? // e.g. student ID / seat number, set by teacher
  // Accommodation: added on top of the exam's normal duration when this
  // student's attempt deadline is computed at join time.
  extraMinutes Int       @default(0)
  createdAt    DateTime  @default(now())
  usedAt       DateTime?

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  // Set when the code was generated from a class roster, so the resulting
  // exam score rolls up automatically into that student's record.
  studentProfileId String?
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)

  attempt ExamAttempt?

  @@index([studentProfileId])
}

model ExamAttempt {
  id             String        @id @default(cuid())
  status         AttemptStatus @default(IN_PROGRESS)
  studentName    String
  studentRef     String?
  startedAt      DateTime      @default(now())
  deadlineAt     DateTime // server-computed: startedAt + exam.durationMinutes, authoritative for timing
  submittedAt    DateTime?
  score          Float?
  maxScore       Float?
  tabViolations  Int           @default(0)
  sessionToken   String        @unique // bound to the browser session that started the attempt
  ipAddress      String?
  questionOrder  String // JSON array of question IDs in the (shuffled) order shown to this student
  choiceOrderMap String // JSON map of questionId -> shuffled choice ID order

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  examCodeId String   @unique
  examCode   ExamCode @relation(fields: [examCodeId], references: [id], onDelete: Cascade)

  answers   Answer[]
  cheatLogs CheatLog[]

  @@index([examId])
}

model Answer {
  id            String   @id @default(cuid())
  textAnswer    String?
  isCorrect     Boolean?
  pointsAwarded Float?
  // Optional written comment from the teacher, shown to the student in the
  // detailed result review alongside the model answer.
  feedback      String?
  updatedAt     DateTime @updatedAt

  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedChoiceId String?
  selectedChoice   Choice? @relation("SelectedChoice", fields: [selectedChoiceId], references: [id])

  @@unique([attemptId, questionId])
}

model CheatLog {
  id        String         @id @default(cuid())
  type      CheatEventType
  detail    String?
  createdAt DateTime       @default(now())

  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}
