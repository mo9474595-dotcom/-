DATABASE_URL="postgresql://user:password@localhost:5432/exam_system?schema=public"
# Deploying on a serverless host (e.g. Vercel) against Neon with many
# concurrent students: use Neon's *pooled* connection string (the host
# has "-pooler" in it, copyable from the Neon dashboard's Connection
# Details panel) instead of the direct one — the direct connection has
# a low concurrent-connection ceiling that a serverless deployment can
# exhaust quickly under load.

# Long random string used to sign teacher login sessions (JWT).
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-this-to-a-long-random-string-in-production"

# Comma-separated, case-insensitive list of existing teacher account
# emails granted the admin dashboard (view every teacher account and its
# class/exam counts, delete an account). There's no separate admin sign-up
# — anyone whose regular teacher account email is listed here sees an
# extra "إدارة الأساتذة" nav item after logging in normally. Leave unset
# to disable the admin dashboard entirely.
# ADMIN_EMAILS="you@example.com,other-admin@example.com"

# Only set this to "true" if this app sits behind a reverse proxy you
# control that sets x-forwarded-for/x-real-ip itself and strips any value
# a client tries to supply (e.g. nginx, a cloud load balancer). Without
# that guarantee, a client could put anything in that header and dodge
# rate limiting entirely, so it's left unset (untrusted) by default.
# TRUST_PROXY_HEADERS="true"
